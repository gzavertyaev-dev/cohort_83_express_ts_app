{
  "compilerOptions": {
    // Настройки среды выполнения (Environment Settings)
    // Указывает формат модулей для скомпилированного кода. CommonJS использует require() и module.exports.
    "module": "commonjs",

    // Задает версию ECMAScript, в которую будет транспилирован ваш TypeScript-код (в стандарт 2020 года).
    "target": "es2020",

    // Для nodejs:
    // Определяет список встроенных библиотек типов (API), которые будут доступны в коде (соответствует ES2020).
    "lib": ["es2020"],

    // Другие выходные файлы (Other Outputs)
    // Включает генерацию source map (.js.map) для отладки JS-кода прямо в исходных .ts файлах.
    "sourceMap": true,

    // Включает генерацию файлов деклараций (.d.ts), которые содержат только типы вашего проекта.
    "declaration": true,

    // Создает карты деклараций (.d.ts.map), чтобы при клике на типы открывался исходный .ts файл, а не .d.ts.
    "declarationMap": true,

    // Рекомендуемые опции (Recommended Options)
    // Включает все строгие проверки типов (strictNullChecks, noImplicitAny и др.) для максимальной безопасности.
    "strict": true,

    // Позволяет импортировать CommonJS-модули как ES-модули (разрешает использовать `import` вместо `require`).
    "esModuleInterop": true,

    // Разрешает импортировать .json файлы напрямую в TypeScript-код как обычные модули.
    "resolveJsonModule": true,

    // Пропускает проверку типов в сторонних файлах (*.d.ts) внутри node_modules, ускоряя компиляцию.
    "skipLibCheck": true
  },

  // Область видимости компилятора (Файлы проекта)
  // Явно указывает TypeScript компилировать только файлы внутри папки `src` и всех её подпапок.
  "include": ["src/**/*"],

  // Исключает указанные папки из процесса компиляции (отменяет их случайное попадание через include).
  // `node_modules` — чтобы не собирать зависимости, `dist` — чтобы не собирать файлы прошлых сборок.
  "exclude": ["node_modules", "dist"]
}
